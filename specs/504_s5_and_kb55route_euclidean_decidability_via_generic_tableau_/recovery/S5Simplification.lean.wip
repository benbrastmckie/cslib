module

import Cslib.Init
public import Cslib.Logics.Modal.Tableau.GenericDriver
public import Cslib.Logics.Modal.Tableau.FrameRules
import Cslib.Logics.Modal.Tableau.Completeness
public import Cslib.Logics.Modal.Tableau.CompletenessLoop

/-! # S5 Universal-Cluster Tableau Simplification

This module defines the S5 "propagate box to ALL branch worlds" universal rule
(`modalApplyOneS5`), which realises S5's single-cluster model property directly, without any
loop-checking machinery (unlike S4, `LoopChecking.lean`). It instantiates the generic tableau
driver (`Saturation.lean`'s `modalStepBranchGen`/`modalExpandBranchesGen`/`modalTableauGen`) at
`modalApplyOneS5`, mirroring the B-system build (`FrameRules.lean`/`BDriver.lean`, task 505)
declaration-for-declaration.

## Main Definitions

- `modalS5BoxAll`/`modalS5DiaNegAll`: the two universal-propagation helpers. From `T(□φ)@w`,
  emit `T(φ)@w'` for **every** known world `w'` of the branch (not just `w` itself, unlike T's
  self-propagation; not just recorded predecessors, unlike B's backward propagation), filtered
  to exclude formulas already present. Dually for `F(◇φ)@w`.
- `modalApplyOneS5`: apply the K rules (`modalApplyOne`) together with the S5 universal
  propagation arms, merging persistent-rule outputs. Reduces to `modalApplyOne` exactly outside
  the two S5-relevant signed-formula shapes (`T(□φ)@w`, `F(◇φ)@w`).
- `modalStepBranchS5`/`modalExpandBranchesS5`/`modalTableauS5`: the S5-system analogues of
  `modalStepBranch`/`modalExpandBranches`/`modalTableau`, each the generic driver instantiated
  at `apply := modalApplyOneS5`.

## Strategy

`modalApplyOneS5` agrees with `modalApplyOne` (K) outside the two S5-relevant signed-formula
shapes (`modalApplyOneS5_eq_of_not_boxPos_diaNeg`), so every `RuleApplicationSpec` field's "not
shaped" case reduces directly to the corresponding K witness. For the two S5-relevant shapes,
`modalApplyOneS5` never mints a world (its accessibility output is exactly K's, unchanged) and
only ever appends universally-propagated formulas at **existing known worlds** of the branch --
this is structurally *simpler* than B's predecessor-restricted backward propagation, since the
target-world bound follows directly from `modalKnownWorlds b`'s own bound (`label_le_modalMaxWorld`)
with no `accFreshInv`/edge-tracing detour, and the known-worlds membership (F6) is immediate by
construction (the propagation is generated by iterating over `modalKnownWorlds b` itself).

## References

* [M. Fitting, *Proof Methods for Modal and Intuitionistic Logics*][Fitting1983], Chapter 2
-/

@[expose] public section

namespace Cslib.Logic.Modal.Tableau

open Cslib.Logic.Tableau Cslib.Logic.Modal

variable {Atom : Type*} [DecidableEq Atom] [Hashable Atom]

/-! ## S5-Specific (Universal-Cluster) Propagation Helpers -/

/-- The S5 universal propagation for box-positives: from `T(□φ)@w`, generate `T(φ)@w'` for
**every** known world `w'` of the branch (drawn from `modalKnownWorlds b`, regardless of any
recorded edge to/from `w`), filtered to exclude formulas already present on the branch. This is
the "propagate box to ALL branch worlds" universal rule realising S5's single-cluster model
property (the extracted model's accessibility relation, taken as the `Relation.EqvGen`-closure
of recorded edges, then trivially relates every known world to every other). -/
def modalS5BoxAll (b : List (SignedFormula (Proposition Atom) WorldIndex))
    (φ : Proposition Atom) (_w : WorldIndex) :
    List (SignedFormula (Proposition Atom) WorldIndex) :=
  (modalKnownWorlds b).filterMap fun w' =>
    let sf : SignedFormula (Proposition Atom) WorldIndex := ⟨.pos, φ, w'⟩
    if b.any (· == sf) then none else some sf

/-- The S5 universal propagation for diamond-negatives: from `F(◇φ)@w`, generate `F(φ)@w'` for
**every** known world `w'` of the branch, filtered to exclude formulas already present on the
branch. Dual of `modalS5BoxAll`. -/
def modalS5DiaNegAll (b : List (SignedFormula (Proposition Atom) WorldIndex))
    (φ : Proposition Atom) (_w : WorldIndex) :
    List (SignedFormula (Proposition Atom) WorldIndex) :=
  (modalKnownWorlds b).filterMap fun w' =>
    let sf : SignedFormula (Proposition Atom) WorldIndex := ⟨.neg, φ, w'⟩
    if b.any (· == sf) then none else some sf

omit [Hashable Atom] in
/-- Membership dichotomy for `modalS5BoxAll`: every emitted formula `⟨.pos, φ, w'⟩` has `w'` a
known world of `b` and was not already on `b`. -/
lemma modalS5BoxAll_mem {b : List (SignedFormula (Proposition Atom) WorldIndex)}
    {φ : Proposition Atom} {w : WorldIndex}
    {x : SignedFormula (Proposition Atom) WorldIndex} (h : x ∈ modalS5BoxAll b φ w) :
    x = (⟨.pos, φ, x.label⟩ : SignedFormula (Proposition Atom) WorldIndex) ∧
      x.label ∈ modalKnownWorlds b ∧ x ∉ b := by
  unfold modalS5BoxAll at h
  obtain ⟨v, hv, heq⟩ := List.mem_filterMap.mp h
  dsimp only at heq
  by_cases hmem : (b.any (· == (⟨.pos, φ, v⟩ : SignedFormula (Proposition Atom) WorldIndex))) =
      true
  · rw [if_pos hmem] at heq; exact absurd heq (by simp)
  · rw [if_neg hmem] at heq
    obtain rfl : (⟨.pos, φ, v⟩ : SignedFormula (Proposition Atom) WorldIndex) = x := by
      injection heq
    exact ⟨rfl, hv, by simpa using hmem⟩

omit [Hashable Atom] in
/-- Membership dichotomy for `modalS5DiaNegAll`, dual of `modalS5BoxAll_mem`. -/
lemma modalS5DiaNegAll_mem {b : List (SignedFormula (Proposition Atom) WorldIndex)}
    {φ : Proposition Atom} {w : WorldIndex}
    {x : SignedFormula (Proposition Atom) WorldIndex} (h : x ∈ modalS5DiaNegAll b φ w) :
    x = (⟨.neg, φ, x.label⟩ : SignedFormula (Proposition Atom) WorldIndex) ∧
      x.label ∈ modalKnownWorlds b ∧ x ∉ b := by
  unfold modalS5DiaNegAll at h
  obtain ⟨v, hv, heq⟩ := List.mem_filterMap.mp h
  dsimp only at heq
  by_cases hmem : (b.any (· == (⟨.neg, φ, v⟩ : SignedFormula (Proposition Atom) WorldIndex))) =
      true
  · rw [if_pos hmem] at heq; exact absurd heq (by simp)
  · rw [if_neg hmem] at heq
    obtain rfl : (⟨.neg, φ, v⟩ : SignedFormula (Proposition Atom) WorldIndex) = x := by
      injection heq
    exact ⟨rfl, hv, by simpa using hmem⟩

omit [Hashable Atom] in
/-- Introduction direction for `modalS5BoxAll`, converse of `modalS5BoxAll_mem`: a known world
`v` of `b` not already carrying `T(φ)@v` on `b` witnesses `T(φ)@v ∈ modalS5BoxAll b φ w`. -/
lemma modalS5BoxAll_mem_of {b : List (SignedFormula (Proposition Atom) WorldIndex)}
    {φ : Proposition Atom} {w v : WorldIndex}
    (hknown : v ∈ modalKnownWorlds b)
    (hnotin : (⟨.pos, φ, v⟩ : SignedFormula (Proposition Atom) WorldIndex) ∉ b) :
    (⟨.pos, φ, v⟩ : SignedFormula (Proposition Atom) WorldIndex) ∈ modalS5BoxAll b φ w := by
  simp only [modalS5BoxAll, List.mem_filterMap]
  exact ⟨v, hknown, by rw [if_neg (by simpa using hnotin)]⟩

omit [Hashable Atom] in
/-- Introduction direction for `modalS5DiaNegAll`, dual of `modalS5BoxAll_mem_of`. -/
lemma modalS5DiaNegAll_mem_of {b : List (SignedFormula (Proposition Atom) WorldIndex)}
    {φ : Proposition Atom} {w v : WorldIndex}
    (hknown : v ∈ modalKnownWorlds b)
    (hnotin : (⟨.neg, φ, v⟩ : SignedFormula (Proposition Atom) WorldIndex) ∉ b) :
    (⟨.neg, φ, v⟩ : SignedFormula (Proposition Atom) WorldIndex) ∈ modalS5DiaNegAll b φ w := by
  simp only [modalS5DiaNegAll, List.mem_filterMap]
  exact ⟨v, hknown, by rw [if_neg (by simpa using hnotin)]⟩

/-! ## S5-Augmented Rule Application -/

/-- Apply the K modal rules together with the S5 universal-propagation arms. For the two
S5-relevant shapes (`T(□φ)@w`, `F(◇φ)@w`), the universal-propagation formulas are merged into
the K rule's `persistent` output (deduplicated); for every other signed-formula shape,
`modalApplyOneS5` reduces to exactly `modalApplyOne` (the K rule dispatch): the S5 arms are pure
`persistent` outputs at existing (known) worlds, never `linear`/`branching`, matching the
report's "no new worlds" classification for S5's universal-cluster simplification. -/
def modalApplyOneS5
    (sf : SignedFormula (Proposition Atom) WorldIndex)
    (b : List (SignedFormula (Proposition Atom) WorldIndex))
    (acc : Accessibility) :
    RuleResult (Proposition Atom) WorldIndex × Accessibility :=
  let (kResult, kAcc) := modalApplyOne sf b acc
  match sf.sign, sf.formula with
  | .pos, .box φ =>
    let allNew := modalS5BoxAll b φ sf.label
    match kResult with
    | .persistent kForms =>
      (.persistent (kForms ++ allNew.filter (fun x => !(kForms.any (· == x)))), kAcc)
    | .notApplicable =>
      if allNew.isEmpty then (.notApplicable, kAcc) else (.persistent allNew, kAcc)
    | other => (other, kAcc)
  | .neg, .diamond φ =>
    let allNew := modalS5DiaNegAll b φ sf.label
    match kResult with
    | .persistent kForms =>
      (.persistent (kForms ++ allNew.filter (fun x => !(kForms.any (· == x)))), kAcc)
    | .notApplicable =>
      if allNew.isEmpty then (.notApplicable, kAcc) else (.persistent allNew, kAcc)
    | other => (other, kAcc)
  | _, _ => (kResult, kAcc)

omit [Hashable Atom] in
/-- `modalApplyOneS5` agrees with `modalApplyOne` outside the two S5-relevant shapes
(`T(□φ)@w`, `F(◇φ)@w`): the S5 arms never affect any other rule dispatch. -/
lemma modalApplyOneS5_eq_of_not_boxPos_diaNeg
    (sf : SignedFormula (Proposition Atom) WorldIndex)
    (b : List (SignedFormula (Proposition Atom) WorldIndex)) (acc : Accessibility)
    (h : ¬ (sf.sign = .pos ∧ ∃ φ, sf.formula = .box φ) ∧
         ¬ (sf.sign = .neg ∧ ∃ φ, sf.formula = .diamond φ)) :
    modalApplyOneS5 sf b acc = modalApplyOne sf b acc := by
  obtain ⟨h1, h2⟩ := h
  unfold modalApplyOneS5
  rcases hs : sf.sign with _ | _ <;> rcases hf : sf.formula with _ | _ | _ | _ | _ | φ | φ <;>
    simp_all

/-! ## S5 Driver Instantiation -/

/-- One-step branch expansion for the S5 (equivalence-frame) tableau: the generic driver
(`modalStepBranchGen`, `Saturation.lean`) instantiated at `apply := modalApplyOneS5`. -/
def modalStepBranchS5
    (b e : List (SignedFormula (Proposition Atom) WorldIndex)) (acc : Accessibility) :
    Option (List (List (SignedFormula (Proposition Atom) WorldIndex)) ×
            List (List (SignedFormula (Proposition Atom) WorldIndex)) ×
            Accessibility) :=
  modalStepBranchGen modalApplyOneS5 b e acc

/-- Fuel-based expansion of a list of S5-system branches: the generic driver
(`modalExpandBranchesGen`, `Saturation.lean`) instantiated at `apply := modalApplyOneS5`. -/
def modalExpandBranchesS5
    (branches expandedSets : List (List (SignedFormula (Proposition Atom) WorldIndex)))
    (accs : List Accessibility) (fuel : Nat) : ModalTableauResult Atom :=
  modalExpandBranchesGen modalApplyOneS5 branches expandedSets accs fuel

/-- The S5-system (equivalence-frame) modal tableau decision procedure: the generic entry point
(`modalTableauGen`, `Saturation.lean`) instantiated at `apply := modalApplyOneS5`, starting the
signed tableau from `F(φ)` at world `0` (same fuel bound as K: S5 never mints a world outside
the K `diamondPos`/`boxNeg` arms, so `modalFuel` is sufficient here too). -/
def modalTableauS5 (φ : Proposition Atom) : ModalTableauResult Atom :=
  modalTableauGen modalApplyOneS5 φ

/-- `modalStepBranchS5` is exactly `modalStepBranchGen modalApplyOneS5` -- true `rfl`. -/
theorem modalStepBranchS5_eq
    (b e : List (SignedFormula (Proposition Atom) WorldIndex)) (acc : Accessibility) :
    modalStepBranchS5 b e acc = modalStepBranchGen modalApplyOneS5 b e acc := rfl

/-- `modalExpandBranchesS5` is exactly `modalExpandBranchesGen modalApplyOneS5` -- true `rfl`. -/
theorem modalExpandBranchesS5_eq
    (branches expandedSets : List (List (SignedFormula (Proposition Atom) WorldIndex)))
    (accs : List Accessibility) (fuel : Nat) :
    modalExpandBranchesS5 branches expandedSets accs fuel =
      modalExpandBranchesGen modalApplyOneS5 branches expandedSets accs fuel := rfl

/-- `modalTableauS5` is exactly `modalTableauGen modalApplyOneS5` -- true `rfl`. -/
theorem modalTableauS5_eq (φ : Proposition Atom) :
    modalTableauS5 φ = modalTableauGen modalApplyOneS5 φ := rfl

/-! ## Phase 2 Obstruction: `RuleApplicationSpec.rankStep` Is Not Dischargeable

**[BLOCKED]** (Phase 2). Attempting to discharge `RuleApplicationSpec modalApplyOneS5`
(mirroring `modalApplyOneB_spec`, `BDriver.lean`) fails at the `rankStep` field
(`GenericDriver.lean`). This section records a fully mechanized, sorry-free counterexample
proving the field is **mathematically false** for `modalApplyOneS5`, not merely unproved.

**Root cause.** `rankStep` requires: given *any* `rank : WorldIndex → Nat` satisfying the
depth-bound invariant `∀ x ∈ b, modalDepth x.formula ≤ rank x.label` and the edge-decrement
invariant `∀ w w', acc.hasEdge w w' → rank w' + 1 = rank w` (the bookkeeping the K-style FMP
potential argument threads through the whole branch), the rule's *new* output formulas must
again satisfy the depth bound at their (possibly-`rank'`-updated) labels. For T's self
propagation (target = the trigger's own world `w`) and B's backward propagation (target = a
*recorded-edge* predecessor of `w`, so `hedge` directly relates `rank v` to `rank w`), this
holds because the target world's rank is provably related to the trigger world's rank via
`hedge`. **S5's universal propagation targets `modalKnownWorlds b` unconditionally** -- a known
world `v` need not have *any* recorded-edge relationship to the trigger world `w` (e.g. `v` may
sit in an unrelated subtree, deeper in the tableau's mint-tree than `w`'s own rank budget
allows) -- so no such relation between `rank v` and `rank w` exists in general, and `rankStep`'s
conclusion can fail.

**Mechanized counterexample.** Instantiate `Atom := Nat`, `φtest := ◇◇(atom 0)` (so
`modalDepth φtest = 2`, `modalDepth (□φtest) = 3`), `sf0 := T(□φtest)@0`, `sf3 := T(atom 0)@3`,
`btest := [sf0, sf3]`, and `acctest` the four-world chain `0 → 1 → 2 → 3`. The tight rank map
`rankTest w := 3 - w` satisfies both `rankStep` hypotheses (`hbound`, `hedge`) at
`(sf0, btest, acctest)` -- confirmed below -- yet `modalApplyOneS5 sf0 btest acctest` (computed
by `rfl`, since every ingredient is a closed, decidable, fully-applied term) emits
`T(φtest)@3` via the universal rule (world `3` is a known world of `btest`), while
`modalDepth φtest = 2 > rankTest 3 = 0`. Since `3 ≠ modalNextWorld btest` (`= 4`), **any**
`rank'` satisfying `rankStep`'s own "agrees with `rank` off the fresh point" clause is *forced*
to have `rank' 3 = rankTest 3 = 0`, so no valid `rank'` can satisfy the field's conclusion. -/

section RankStepObstruction

def s5RankCounterFormula : Proposition Nat := .diamond (.diamond (.atom 0))

def s5RankCounterSf0 : SignedFormula (Proposition Nat) WorldIndex :=
  ⟨.pos, .box s5RankCounterFormula, 0⟩

def s5RankCounterSf3 : SignedFormula (Proposition Nat) WorldIndex :=
  ⟨.pos, .atom 0, 3⟩

def s5RankCounterBranch : List (SignedFormula (Proposition Nat) WorldIndex) :=
  [s5RankCounterSf0, s5RankCounterSf3]

def s5RankCounterAcc : Accessibility :=
  ((Accessibility.empty.addEdge 0 1).addEdge 1 2).addEdge 2 3

def s5RankCounterRank : WorldIndex → Nat := fun w => 3 - w

lemma s5RankCounter_sf0_mem : s5RankCounterSf0 ∈ s5RankCounterBranch := by decide

lemma s5RankCounter_accFreshInv :
    accFreshInv s5RankCounterBranch s5RankCounterAcc := by
  intro w w' hedge
  simp only [s5RankCounterAcc, Accessibility.addEdge, Accessibility.hasEdge,
    Accessibility.empty, List.any_cons, List.any_nil, Bool.or_eq_true, Bool.and_eq_true,
    beq_iff_eq] at hedge
  rcases hedge with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | hf <;>
    simp_all [modalNextWorld, modalMaxWorld, s5RankCounterBranch, s5RankCounterSf0,
      s5RankCounterSf3, List.foldl]

lemma s5RankCounter_hbound :
    ∀ x ∈ s5RankCounterBranch, modalDepth x.formula ≤ s5RankCounterRank x.label := by
  intro x hx
  simp only [s5RankCounterBranch, List.mem_cons, List.not_mem_nil, or_false] at hx
  rcases hx with rfl | rfl <;>
    simp [s5RankCounterSf0, s5RankCounterSf3, s5RankCounterFormula, modalDepth,
      s5RankCounterRank]

lemma s5RankCounter_hedge :
    ∀ w w', s5RankCounterAcc.hasEdge w w' → s5RankCounterRank w' + 1 = s5RankCounterRank w := by
  intro w w' hedge
  simp only [s5RankCounterAcc, Accessibility.addEdge, Accessibility.hasEdge,
    Accessibility.empty, List.any_cons, List.any_nil, Bool.or_eq_true, Bool.and_eq_true,
    beq_iff_eq] at hedge
  rcases hedge with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | hf <;> simp_all [s5RankCounterRank]

lemma s5RankCounter_fst :
    (modalApplyOneS5 s5RankCounterSf0 s5RankCounterBranch s5RankCounterAcc).fst =
      RuleResult.persistent
        [⟨.pos, s5RankCounterFormula, 1⟩, ⟨.pos, s5RankCounterFormula, 3⟩,
          ⟨.pos, s5RankCounterFormula, 0⟩] := by rfl

lemma s5RankCounter_three_ne_next :
    (3 : WorldIndex) ≠ modalNextWorld s5RankCounterBranch := by decide

/-- **The mechanized counterexample**: `RuleApplicationSpec.rankStep` (`GenericDriver.lean`)
fails for `modalApplyOneS5` at this concrete, fully-decidable instantiation. No valid `rank'`
exists satisfying all three conjuncts of the field's conclusion, because any such `rank'` is
forced to agree with `s5RankCounterRank` at world `3` (`≠ modalNextWorld s5RankCounterBranch`),
and `s5RankCounterFormula`'s depth (`2`) exceeds `s5RankCounterRank 3` (`0`) while
`T(s5RankCounterFormula)@3` is a genuine member of the rule's persistent output. This is the
formal record of Phase 2's `[BLOCKED]` status: the universal "propagate to every known world"
S5 rule cannot be discharged against the K-style FMP `rank`-potential machinery
`RuleApplicationSpec` presupposes, for the same underlying reason `S4`'s transitive 4-rule
cannot (`GenericDriver.lean`'s module docstring, "S4 is explicitly NOT an instance"): both
propagate content to worlds whose depth-budget is not controlled by any recorded edge to the
trigger world. -/
theorem modalApplyOneS5_rankStep_not_dischargeable :
    ¬ ∃ rank' : WorldIndex → Nat,
        (∀ w, w ≠ modalNextWorld s5RankCounterBranch → rank' w = s5RankCounterRank w) ∧
        (∀ w w', (modalApplyOneS5 s5RankCounterSf0 s5RankCounterBranch
              s5RankCounterAcc).snd.hasEdge w w' → rank' w' + 1 = rank' w) ∧
        (match (modalApplyOneS5 s5RankCounterSf0 s5RankCounterBranch
              s5RankCounterAcc).fst with
          | .linear formulas => ∀ x ∈ formulas, modalDepth x.formula ≤ rank' x.label
          | .branching branches => ∀ x ∈ branches.flatten, modalDepth x.formula ≤ rank' x.label
          | .persistent formulas => ∀ x ∈ formulas, modalDepth x.formula ≤ rank' x.label
          | .notApplicable => True) := by
  rintro ⟨rank', hagree, -, hmatch⟩
  rw [s5RankCounter_fst] at hmatch
  simp only at hmatch
  have h3 : modalDepth s5RankCounterFormula ≤ rank' 3 :=
    hmatch ⟨.pos, s5RankCounterFormula, 3⟩ (by simp)
  have hagree3 : rank' 3 = s5RankCounterRank 3 := hagree 3 s5RankCounter_three_ne_next
  rw [hagree3] at h3
  simp only [s5RankCounterFormula, modalDepth, s5RankCounterRank] at h3
  omega

end RankStepObstruction

end Cslib.Logic.Modal.Tableau

end
