    ⟨φ, hsign, hform, -, hnk, hshape⟩ | ⟨φ, hsign, hform, -, hnk, hshape⟩
  · intro b' hb'
    rw [hnewBs] at hb'
    simp only [List.mem_singleton] at hb'
    subst hb'
