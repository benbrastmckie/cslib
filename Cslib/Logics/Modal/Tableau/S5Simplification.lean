    modalStepBranchS5gKeyed_keys_shape φ₀ b e acc keys newBs newExps newAcc newKeys hstep
  have hkinuniv : ∀ (s : Sign) (φ : Proposition Atom), φ ∈ modalSubfmls φ₀ →
      successorBirthContentS5 φ₀ b s φ sf.label ⊆ signedSubfmls φ₀ := by
    intro s φ hφ
