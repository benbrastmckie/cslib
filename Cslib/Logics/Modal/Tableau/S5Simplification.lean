    simp only at hK
    rw [hp] at hKW
    simp only at hKW
    rcases hK with hK | ⟨out0, hK⟩ <;> subst hK
    · rcases hKW with ⟨hsndeq, -⟩ | ⟨-, hmatch⟩
      swap
      · exact hmatch.elim
      subst hsndeq
