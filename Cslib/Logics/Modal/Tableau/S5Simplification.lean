          intro x hx
          simp only [List.mem_append, List.mem_filter] at hx
          rcases hx with hx | ⟨hx, -⟩
          · exact hKsub x hx
          · exact hallNew x hx
    · rw [modalApplyOneS5_eq_of_not_boxPos_diaNeg sf b acc
