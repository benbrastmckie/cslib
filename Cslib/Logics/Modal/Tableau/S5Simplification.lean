      · rw [hm] at hmatch; exact hmatch.elim
      · rw [hm] at hmatch; exact hmatch.elim
  rcases hcase with ⟨wBlock, -, hnewBs, hnk⟩ | ⟨hnk, hsnd, hshape⟩ |
