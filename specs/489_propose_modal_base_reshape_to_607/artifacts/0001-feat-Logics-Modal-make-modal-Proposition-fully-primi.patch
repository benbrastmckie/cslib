 #grind_lint skip Cslib.LTS.IsBisimulationUpTo.isBisimulation
 #grind_lint skip Cslib.Logic.HML.theoryEq_isBisimulation
+-- `not_denotation`'s proof now routes through the derived-negation `grind =` lemma set
