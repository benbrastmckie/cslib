    · rw [hw2]; exact hwBlock
    · exact hknown w w' hold
  · have hbb' : ∀ b' ∈ newBs, ∃ xs, b' = xs ++ b := by
      intro b' hb'
      rcases hm : (modalApplyOneS5 sf b acc).fst with nf | brs | nf | -
