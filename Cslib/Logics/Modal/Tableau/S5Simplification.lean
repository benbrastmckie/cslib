      (w : WorldIndex) (k : Finset (Sign × Proposition Atom)),
      k ⊆ relevantSetFinset φ₀ b w → k ⊆ relevantSetFinset φ₀ (xs ++ b) w := fun xs w k hk =>
    hk.trans (relevantSetFinset_mono φ₀ b (xs ++ b) w
