  obtain ⟨sf, hsfmem, hsf⟩ := List.exists_of_findSome?_eq_some hstep
  clear hstep
  by_cases hexp : e.any (· == sf) = true
  · simp only [hexp, if_true] at hsf
    exact absurd hsf (by simp)
