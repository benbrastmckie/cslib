+                    intApplyRuleFull sf nwH bPers = result := by
+                  simp only [intStepBranch] at hstep
+                  -- findSome? returned some (result, newExp)
+                  -- We need the sf witness from findSome?
+                  have : ∃ sf ∈ bPers, ¬ eH.any (· == sf) ∧
+                      intApplyRuleFull sf nwH bPers = result := by
+                    rw [List.findSome?_eq_some_iff] at hstep
+                    obtain ⟨sf, hsf_mem, -, hval⟩ := hstep
+                    simp only [Bool.not_eq_true] at hval
+                    split_ifs at hval with hexp
+                    · simp at hval
+                    · cases happ : intApplyRuleFull sf nwH bPers with
+                      | notApplicable => simp [happ] at hval
+                      | linearResult => simp [happ] at hval; exact ⟨sf, hsf_mem, hexp, by rw [← happ, hval]⟩
+                      | branchingResult => simp [happ] at hval; exact ⟨sf, hsf_mem, hexp, by rw [← happ, hval]⟩
+                  obtain ⟨sf, hsf_mem, _, hres⟩ := this
+                  exact ⟨sf, hsf_mem, fun sf' _ _ => sorry, hres⟩
+                obtain ⟨sf, hsf_mem, _, hresult_sf⟩ := ⟨sf, hsf_mem, hfresh_sf, hresult_sf⟩
+                cases hresult : result with
+                | linearResult newForms nw' newEdge =>
+                  rw [hresult] at hgo hstep hresult_sf
+                  -- Need freshness: ∀ sf' ∈ bPers, sf'.label ≠ nwH
+                  have hfresh : ∀ sf' ∈ bPers, sf'.label ≠ nwH := by sorry
+                  rcases hzip_p with ⟨rfl, rfl⟩ | hmem_rest
+                  · -- bp = bh, edgesP = edgesH
+                    -- Get bPers satisfaction from hmono_p
+                    have hsat_pers : intBranchSatisfied val botForces wo bPers :=
+                      applyPersistenceFixpoint_sat val botForces v_uc bf_uc wo bh edgesH (fuel'' + 1)
+                        hsat_p hmono_p
+                    -- Apply intRule_preserves_sat for linearResult
+                    obtain ⟨worldOf', hwo'_agree, hsat_ext⟩ :=
+                      (intRule_preserves_sat val botForces v_uc bf_uc wo bPers sf hsf_mem
+                        hsat_pers nwH hfresh).1 (by rw [hresult_sf])
+                    -- newEdge: either none (worldOf' = wo) or some (w1,w2) (new edge added)
+                    -- edges' = if newEdge.isSome then edgesH ++ [newEdge.get] else edgesH
+                    set edges' := match newEdge with | none => edgesH | some e => edgesH ++ [e]
+                    -- MonotoneEdges worldOf' edges'
+                    have hmono' : MonotoneEdges worldOf' edges' := by
+                      cases newEdge with
+                      | none =>
+                        -- edges' = edgesH; worldOf' agrees with wo except at nwH
+                        -- Need MonotoneEdges worldOf' edgesH
+                        -- Since worldOf' k = wo k for k ≠ nwH and nwH is fresh (not in branch),
+                        -- MonotoneEdges worldOf' edgesH follows from MonotoneEdges wo edgesH
+                        -- plus the freshness of nwH
+                        -- This requires: for all (w,w') in edges, nwH ∉ {w, w'}
+                        -- (since worldOf' only differs at nwH)
+                        simp only [edges']
+                        intro w1 w2 hacc
+                        sorry -- MonotoneEdges worldOf' edgesH from hmono_p
+                      | some ⟨nwChild, nwParent⟩ =>
+                        -- edges' = edgesH ++ [(nwChild, nwParent)]
+                        -- worldOf' = Function.update wo nwH w'_new
+                        -- This is the F(imp) case; use monotoneEdges_update
+                        simp only [edges']
+                        sorry -- monotoneEdges_update
+                    -- The new branch Branch.extendMany bPers newForms ∈ new branches
+                    -- Apply IH (fuel'' induction) to get contradiction
+                    let new_branches := done ++ [Branch.extendMany bPers newForms] ++ bt
+                    let new_edgeSets := doneEdges ++ [edges'] ++ edgesT
+                    have hmem_new : (Branch.extendMany bPers newForms, edges') ∈
+                        new_branches.zip new_edgeSets := by
+                      simp [new_branches, new_edgeSets, hdlength_edges]
+                    exact ih new_branches
+                        (doneExp ++ [newExp] ++ eT)
+                        (doneNW ++ [nw'] ++ nwT)
+                        new_edgeSets
+                        (by simp [new_branches, new_edgeSets, hdlength_exp, hlength_exp])
+                        (by simp [new_branches, new_edgeSets, hdlength_nw, hlength_nw])
+                        (by simp [new_branches, new_edgeSets, hdlength_edges, hlength_edges])
+                        (by simpa [hresult, show edges' = match newEdge with | none => edgesH | some e => edgesH ++ [e] from rfl] using hgo)
+                        (Branch.extendMany bPers newForms) edges'
+                        hmem_new worldOf' hmono' hsat_ext
+                  · -- bp ∈ bt (not the head branch)
+                    exact ih_inner eT nwT edgesT (done ++ [Branch.extendMany bPers newForms])
+                        (doneExp ++ [newExp]) (doneNW ++ [nw']) (doneEdges ++ [edges'])
+                        hlength_exp hlength_nw hlength_edges
+                        (by simp [hdlength_exp]) (by simp [hdlength_nw]) (by simp [hdlength_edges])
+                        (by simpa [hresult, show edges' = match newEdge with | none => edgesH | some e => edgesH ++ [e] from rfl] using hgo)
+                        bp edgesP hmem_rest wo hmono_p hsat_p
+                | branchingResult branches' nw' =>
+                  rw [hresult] at hgo hstep hresult_sf
+                  have hfresh : ∀ sf' ∈ bPers, sf'.label ≠ nwH := by sorry
+                  rcases hzip_p with ⟨rfl, rfl⟩ | hmem_rest
+                  · -- bp = bh, edgesP = edgesH
+                    have hsat_pers : intBranchSatisfied val botForces wo bPers :=
+                      applyPersistenceFixpoint_sat val botForces v_uc bf_uc wo bh edgesH (fuel'' + 1)
+                        hsat_p hmono_p
+                    obtain ⟨br, hbr_mem, hbr_sat⟩ :=
+                      (intRule_preserves_sat val botForces v_uc bf_uc wo bPers sf hsf_mem
+                        hsat_pers nwH hfresh).2 (by rw [hresult_sf])
+                    have hmem_ext : (Branch.extendMany bPers br, edgesH) ∈
+                        (done ++ branches'.map (Branch.extendMany bPers ·) ++ bt).zip
+                        (doneEdges ++ branches'.map (fun _ => edgesH) ++ edgesT) := by
+                      simp [hbr_mem, hdlength_edges]
+                    exact ih (done ++ branches'.map (Branch.extendMany bPers ·) ++ bt)
+                        (doneExp ++ branches'.map (fun _ => newExp) ++ eT)
+                        (doneNW ++ branches'.map (fun _ => nw') ++ nwT)
+                        (doneEdges ++ branches'.map (fun _ => edgesH) ++ edgesT)
+                        (by simp [hdlength_exp, hlength_exp])
+                        (by simp [hdlength_nw, hlength_nw])
+                        (by simp [hdlength_edges, hlength_edges])
+                        (by simpa [hresult] using hgo)
+                        (Branch.extendMany bPers br) edgesH hmem_ext wo hmono_p hbr_sat
+                  · exact ih_inner eT nwT edgesT
+                        (done ++ branches'.map (Branch.extendMany bPers ·))
+                        (doneExp ++ branches'.map (fun _ => newExp))
+                        (doneNW ++ branches'.map (fun _ => nw'))
+                        (doneEdges ++ branches'.map (fun _ => edgesH))
+                        hlength_exp hlength_nw hlength_edges
+                        (by simp [hdlength_exp]) (by simp [hdlength_nw]) (by simp [hdlength_edges])
+                        (by simpa [hresult] using hgo)
+                        bp edgesP hmem_rest wo hmono_p hsat_p
+                | notApplicable =>
+                  rw [hresult] at hgo; simp [intExpandBranches.go] at hgo
 
 /-! ## Main Soundness Theorem -/
 
