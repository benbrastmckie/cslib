+/-- `intStepBranch` never returns `some (.notApplicable, _)`.
+
+The inner function passed to `findSome?` always returns either `none` (when the formula is
+already in `expanded`, or when `intApplyRuleFull` gives `.notApplicable`) or
+`some (result, expanded ++ [sf])` where `result` is a `linearResult` or `branchingResult`
+(since `.notApplicable` is filtered to `none`). Hence `findSome?` cannot return
+`some (.notApplicable, _)`. -/
+private lemma intStepBranch_result_not_notApplicable
+    (b : IBranch Atom) (expanded : List (ISF Atom)) (nextWorld : Nat)
+    (exp' : List (ISF Atom)) :
+    intStepBranch b expanded nextWorld ≠ some (.notApplicable, exp') := by
+  unfold intStepBranch
+  intro hstep
+  obtain ⟨sf, _, hval⟩ := List.exists_of_findSome?_eq_some hstep
+  -- The inner function returns some (result, _) only when intApplyRuleFull ≠ notApplicable
+  by_cases h1 : expanded.any (· == sf) = true
+  · -- expanded contains sf: inner function returns none
+    rw [if_pos h1] at hval
+    exact absurd hval (by simp)
+  · -- sf not in expanded: inner function applies the rule
+    rw [Bool.not_eq_true] at h1
+    rw [if_neg (by simp [h1])] at hval
+    -- case split on intApplyRuleFull to see it never gives notApplicable
+    cases h2 : intApplyRuleFull sf nextWorld b with
+    | notApplicable =>
+      -- notApplicable → inner function returns none, not some
+      rw [h2] at hval; exact absurd hval (by simp)
+    | linearResult newForms nw' edge =>
+      -- linearResult ≠ notApplicable → discriminator mismatch
+      rw [h2] at hval; exact absurd hval (by simp)
+    | branchingResult branches' nw' =>
+      -- branchingResult ≠ notApplicable → discriminator mismatch
+      rw [h2] at hval; exact absurd hval (by simp)
+
